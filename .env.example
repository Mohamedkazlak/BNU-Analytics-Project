# Frontend
VITE_BACKEND_URL=http://localhost:8000

# Backend (export these before `uvicorn main:app --reload` from backend/)
APP_ENV=development

# Application connection. In production this MUST be a non-BYPASSRLS role
# (recommended name: app_user). Do not use the Supabase postgres role for the
# API — that role bypasses row-level security.
# Local example after: ALTER ROLE app_user LOGIN PASSWORD '...';
# Supabase pooler example:
#   postgresql://app_user.<project-ref>:<app-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/postgres

# Optional privileged URL for schema/migrations (table owner / postgres).
# Defaults to DATABASE_URL when unset. Never commit the real password.
# DATABASE_ADMIN_URL=postgresql://postgres:change-me@localhost:5432/postgres

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AI_BUDGET_SECONDS=8
AI_CACHE_TTL_SECONDS=60
